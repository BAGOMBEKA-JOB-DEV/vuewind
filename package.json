{
  "name": "vuewind",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "serve": "serve dist -l 80",
    "lint": "eslint src/lib src/docs src/stores/theme.js src/stores/docs.js",
    "format": "prettier --write src/",
    "build:lib": "vite build --config vite.lib.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format:new": "prettier --write src/lib src/docs src/stores/theme.js src/stores/docs.js tests",
    "types": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vueuse/core": "^10.7.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "flatpickr": "^4.6.13",
    "js-cookie": "^3.0.5",
    "jsvectormap": "^1.5.3",
    "jwt-decode": "^4.0.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.4.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.0.3",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.11"
  },
  "description": "Thoughtful Vue components and an interactive documentation workspace",
  "exports": {
    ".": {
      "types": "./lib-dist/index.d.ts",
      "import": "./lib-dist/vuewind.js"
    },
    "./style.css": "./lib-dist/style.css"
  },
  "files": [
    "lib-dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "types": "./lib-dist/index.d.ts"
}
